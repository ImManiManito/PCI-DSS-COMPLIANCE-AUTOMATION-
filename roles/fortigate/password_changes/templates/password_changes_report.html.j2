<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Cambio trimestral de contraseñas VPN - FortiGate</title>
<style>
body{font-family:Segoe UI,Arial,sans-serif;margin:24px;color:#222}
h1{font-size:20px;margin-bottom:4px}
.meta td{padding:2px 12px 2px 0}
table.r{border-collapse:collapse;width:100%;margin-top:16px}
table.r th,table.r td{border:1px solid #ccc;padding:6px 10px;font-size:13px;text-align:left}
table.r th{background:#1f3a5f;color:#fff}
.OK{color:#0a7a2f;font-weight:bold}
.FAILED{color:#b00020;font-weight:bold}
.SKIPPED,.NOT_SENT{color:#8a6d00;font-weight:bold}
</style>
</head>
<body>
<h1>Reporte de cambio trimestral de contraseñas - Usuarios VPN FortiGate</h1>
<p>PCI DSS 8.3.9 / 8.3.10.1 &mdash; este reporte no contiene contraseñas.</p>
<table class="meta">
<tr><td><b>Fecha de ejecución</b></td><td>{{ fortigate_pwd_report_date }}</td></tr>
<tr><td><b>Dispositivos</b></td><td>{{ groups['fortigates'] | join(', ') | e }}</td></tr>
<tr><td><b>Usuarios evaluados</b></td><td>{{ fortigate_pwd_results | length }}</td></tr>
<tr><td><b>Contraseñas cambiadas</b></td><td>{{ fortigate_pwd_results | selectattr('changed', 'equalto', 'OK') | list | length }}</td></tr>
<tr><td><b>Correos enviados</b></td><td>{{ fortigate_pwd_results | selectattr('mail', 'equalto', 'OK') | list | length }}</td></tr>
<tr><td><b>Fallidos / omitidos</b></td><td>{{ fortigate_pwd_results | selectattr('changed', 'in', ['FAILED', 'SKIPPED']) | list | length }}</td></tr>
</table>
<table class="r">
<tr><th>Dispositivo</th><th>Usuario</th><th>Correo destino</th><th>Cambio de contraseña</th><th>Envío de correo</th><th>Observación</th></tr>
{% for r in fortigate_pwd_results %}
<tr>
<td>{{ r.device | e }}</td>
<td>{{ r.name | e }}</td>
<td>{{ (r.email | default('N/A', true)) | e }}</td>
<td class="{{ r.changed }}">{{ r.changed }}</td>
<td class="{{ r.mail }}">{{ r.mail }}</td>
<td>{{ r.note | e }}</td>
</tr>
{% endfor %}
</table>
</body>
</html>