{% macro mark(s) -%}
{%- if s == 'OK' -%}<span class="ok">&#10003;</span>
{%- elif s == 'QUEUED' -%}<span class="warn">En cola</span>
{%- elif s == 'FAILED' -%}<span class="bad">&#10007;</span>
{%- else -%}<span class="na">&mdash;</span>
{%- endif -%}
{%- endmacro %}
{% set ns = namespace(changed=0, mailed=0, problems=0, rows=[]) %}
{% for r in fortigate_pwd_results %}
{% set mail = 'QUEUED' if (r.mail == 'OK' and r.email | lower in fortigate_pwd_mailq | lower) else r.mail %}
{% set ns.rows = ns.rows + [r | combine({'mail': mail})] %}
{% if r.changed == 'OK' %}{% set ns.changed = ns.changed + 1 %}{% endif %}
{% if mail == 'OK' %}{% set ns.mailed = ns.mailed + 1 %}{% endif %}
{% if r.changed != 'OK' or mail not in ['OK', 'QUEUED'] %}{% set ns.problems = ns.problems + 1 %}{% endif %}
{% endfor %}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reporte de actividad - Cambio de contraseñas de VPN</title>
<style>
body{margin:0;padding:28px 12px;background:#0b0b0b;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#d8d8d8}
.card{max-width:800px;margin:0 auto;background:#141414;border:1px solid #2a2a2a;border-radius:4px}
.hdr{background:#0b0b0b;border-bottom:4px solid #c4001a;padding:18px 26px}
.hdr table{width:100%;border-collapse:collapse}
.hdr img{height:46px;display:block}
.hdr .t{text-align:right;color:#fff;font-size:19px;font-weight:700}
.body{padding:26px}
table.info{width:100%;border-collapse:collapse;margin-bottom:28px}
table.info td{border:1px solid #2a2a2a;padding:13px 14px;font-size:14px;background:#161616}
table.info td.l{background:#c4001a;color:#fff;font-weight:700;width:170px}
h2{font-size:15px;color:#fff;margin:0 0 12px;padding-left:12px;border-left:4px solid #c4001a}
table.tiles{width:100%;border-collapse:separate;border-spacing:10px;margin:0 -10px 18px}
table.tiles td{width:33.3%;background:#141414;border:1px solid #2a2a2a;border-left:3px solid #c4001a;padding:11px 14px;vertical-align:top}
table.tiles td.plain{border-left:1px solid #2a2a2a}
.k{font-size:11px;color:#9a9a9a;text-transform:uppercase;letter-spacing:.3px}
.v{font-size:17px;font-weight:700;color:#fff;margin-top:5px}
table.ev{width:100%;border-collapse:collapse;border:1px solid #2a2a2a;margin-top:4px}
table.ev th{background:#0b0b0b;color:#fff;font-size:14px;padding:14px;border:1px solid #2a2a2a;border-bottom:3px solid #c4001a;text-align:center}
table.ev th.u{text-align:left}
table.ev td{padding:14px;border:1px solid #2a2a2a;font-size:14px;color:#bdbdbd;text-align:center}
table.ev td.u{text-align:left}
.note{font-size:11px;color:#8c8c8c;margin-top:4px}
.ok{color:#e0001b;font-size:20px;font-weight:700}
.bad{color:#ffb300;font-size:20px;font-weight:700}
.warn{color:#ffb300;font-size:12px;font-weight:700}
.na{color:#666}
.foot{padding:14px 26px;border-top:1px solid #2a2a2a;font-size:11px;color:#777}
</style>
</head>
<body>
<div class="card">
<div class="hdr"><table><tr>
<td><img src="data:image/png;base64,{{ fortigate_pwd_logo_b64 }}" alt="Sayabha"></td>
<td class="t">Reporte de actividad</td>
</tr></table></div>
<div class="body">

<table class="info">
<tr><td class="l">Nombre de la actividad</td><td>Cambio de contraseñas de VPN</td></tr>
<tr><td class="l">Fecha y hora</td><td>{{ fortigate_pwd_datetime }}</td></tr>
<tr><td class="l">Realizado por</td><td>{{ fortigate_pwd_operator | e }}</td></tr>
</table>

<h2>Resumen de ejecución</h2>
<table class="tiles">
<tr>
<td><div class="k">Fecha de ejecución</div><div class="v">{{ fortigate_pwd_report_date }}</div></td>
<td><div class="k">Dispositivos</div><div class="v">{{ groups['fortigates'] | join(', ') | e }}</div></td>
<td><div class="k">Usuarios evaluados</div><div class="v">{{ ns.rows | length }}</div></td>
</tr>
<tr>
<td><div class="k">Contraseñas cambiadas</div><div class="v">{{ ns.changed }}</div></td>
<td><div class="k">Correos enviados</div><div class="v">{{ ns.mailed }}</div></td>
<td class="plain"><div class="k">Fallidos / omitidos</div><div class="v">{{ ns.problems }}</div></td>
</tr>
</table>

<h2>Evidencia</h2>
<table class="ev">
<tr><th class="u">Nombre de usuario de VPN</th><th style="width:120px">Cambio realizado</th><th style="width:120px">Correo enviado</th></tr>
{% for r in ns.rows %}
<tr>
<td class="u">{{ r.name | e }}
{% if r.changed != 'OK' or r.mail != 'OK' %}<div class="note">{{ ('Correo aceptado por postfix, aún en cola de entrega' if r.mail == 'QUEUED' else r.note) | e }}</div>{% endif %}
</td>
<td>{{ mark(r.changed) }}</td>
<td>{{ mark(r.mail) }}</td>
</tr>
{% endfor %}
</table>

</div>
<div class="foot">PCI DSS 8.3.9 / 8.3.10.1 &middot; Este reporte no contiene contraseñas.</div>
</div>
</body>
</html>